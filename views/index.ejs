<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= PROMO_TITLE %></title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="top">
    <div class="brand">
      <img class="logo" src="/logo-redpiso.svg" alt="RedPiso"/>
      <div class="brandText">
        <div class="kicker">RedPiso</div>
        <h1><%= PROMO_TITLE %></h1>
        <p class="sub"><%= PROMO_SUBTITLE %></p>
      </div>
    </div>

    <div class="stats">
      <div class="pill"><strong><%= stats.total %></strong> / 50 plazas</div>
      <div class="pill ghost">Quedan <strong><%= stats.remaining %></strong></div>
    </div>
  </header>

  <main class="wrap">

    <% if (stats.winner) { %>
      <section class="card success">
        <h2>🎉 ¡Ya hay ganador!</h2>
        <p>
          <strong><%= stats.winner.first_name %> <%= stats.winner.last_name %></strong>
          <span class="muted">(sorteado: <%= stats.drawn_at %>)</span>
        </p>
        <p class="muted">Gracias por participar. Muy pronto más sorteos.</p>
      </section>
    <% } %>

    <% if (q && q.err) { %>
      <section class="card warn"><%= q.err %></section>
    <% } %>

    <% if ((q && q.full) && !stats.winner) { %>
      <section class="card warn">
        <h2>¡Cupos completos! 🔥</h2>
        <p>Ya tenemos 50 solicitudes. En breve publicaremos el ganador.</p>
      </section>
    <% } %>

    <% if (!stats.isFull && !stats.winner) { %>
      <section class="card">
        <h2>Valoración gratis + participación</h2>
        <p class="muted">
          Déjanos tus datos y tu dirección. Te contactamos para una valoración <strong>sin compromiso</strong>.
          <br/>La participación del sorteo se asigna cuando vayamos a valorar tu vivienda.
        </p>

        <form method="POST" action="/participar" class="form">
          <div class="grid">
            <label>
              Nombre
              <input name="first_name" required minlength="2" placeholder="Nombre" />
            </label>
            <label>
              Apellidos
              <input name="last_name" required minlength="2" placeholder="Apellidos" />
            </label>
          </div>

          <label>
            Teléfono
            <input name="phone" required placeholder="Teléfono" inputmode="tel" />
          </label>

          <label>
            Dirección de la vivienda
            <input name="address" required minlength="8" placeholder="Calle, número, ciudad (si quieres, piso/puerta)" />
            <span class="hint">Tranquilo: es solo para poder hacerte la valoración. Sin compromiso.</span>
          </label>

          <div class="check">
            <label class="checkRow">
              <input type="checkbox" name="followed_socials" required />
              <span>Confirmo que sigo a RedPiso en Instagram (requisito)</span>
            </label>

            <div class="socials">
            <a class="btn small ig-btn" href="<%= IG_URL %>" target="_blank" rel="noopener">
  
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="white" viewBox="0 0 24 24">
    <path d="M7.75 2C4.57 2 2 4.57 2 7.75v8.5C2 19.43 4.57 22 7.75 22h8.5C19.43 22 22 19.43 22 16.25v-8.5C22 4.57 19.43 2 16.25 2h-8.5zm0 2h8.5A3.75 3.75 0 0 1 20 7.75v8.5A3.75 3.75 0 0 1 16.25 20h-8.5A3.75 3.75 0 0 1 4 16.25v-8.5A3.75 3.75 0 0 1 7.75 4zm8.75 1.5a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5zM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"/>
  </svg>

  Instagram
</a>


            </div>

            <span class="hint">
              Verificación: el ganador deberá demostrar que nos sigue para recibir el premio ✅
            </span>
          </div>

          <button class="btn primary" type="submit">Entrar en el sorteo</button>

          <p class="legal">
            Tus datos están protegidos y no se compartirán con terceros.
          </p>
        </form>
      </section>
    <% } %>

  </main>

  <footer class="foot">
    <span class="muted">© <%= new Date().getFullYear() %> RedPiso</span>
  </footer>
</body>
</html>
